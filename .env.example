# Copia este archivo a .env.local y rellena los valores.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # secreto — solo se usa en server actions del admin

# Panel /admin
ADMIN_PASSWORD=                   # contraseña del panel /admin
ADMIN_SESSION_TOKEN=              # secreto aleatorio para firmar la sesión (HMAC)

# Opcional: URL pública del sitio, para Open Graph (metadataBase)
NEXT_PUBLIC_SITE_URL=              # ej. https://quiniela-hunters.vercel.app
